# Copy to .env and fill in. AWS keys may go only in your local, git-ignored
# .env (or be exported in your terminal), never in code or in this file.
AWS_REGION=us-east-1
S3_BUCKET=second-look-<team-name>

# Inference profile IDs (look up in the Bedrock console or with
# `aws bedrock list-inference-profiles --region us-east-1`)
SONNET_MODEL_ID=
HAIKU_MODEL_ID=

GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Seconds to pause between Bedrock calls (event limit is ~1 call/sec)
BEDROCK_PAUSE_SECONDS=1.2

# Event temporary credentials: uncomment in .env only
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
