# Copy to .env and fill in. Do NOT put AWS keys here. Use the event's
# temporary credentials exported in your terminal instead.
AWS_REGION=us-east-1
S3_BUCKET=second-look-<team-name>

# Inference profile IDs (look up in the Bedrock console or with
# `aws bedrock list-inference-profiles --region us-east-1`)
SONNET_MODEL_ID=
HAIKU_MODEL_ID=

GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Seconds to pause between Bedrock calls (event limit is ~1 call/sec)
BEDROCK_PAUSE_SECONDS=1.2
